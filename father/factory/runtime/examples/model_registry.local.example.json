{
  "models": [
    {
      "model_id": "ollama-champion",
      "provider": "ollama",
      "model": "YOUR_LOCAL_MODEL",
      "roles": ["CHAMPION"],
      "capabilities": ["*"],
      "allowed_data_classes": ["PUBLIC", "INTERNAL", "SENSITIVE"],
      "endpoint": "http://127.0.0.1:11434",
      "enabled": false
    },
    {
      "model_id": "local-challenger-1",
      "provider": "openai_compatible",
      "model": "YOUR_CHALLENGER_MODEL",
      "roles": ["CHALLENGER"],
      "capabilities": ["*"],
      "allowed_data_classes": ["PUBLIC", "INTERNAL"],
      "endpoint": "http://127.0.0.1:1234/v1",
      "enabled": false
    },
    {
      "model_id": "remote-public-only",
      "provider": "openai_compatible",
      "model": "YOUR_REMOTE_MODEL",
      "roles": ["CHAMPION", "CHALLENGER", "JUDGE"],
      "capabilities": ["*"],
      "allowed_data_classes": ["PUBLIC"],
      "endpoint": "${FATHER_REMOTE_LLM_BASE_URL}",
      "api_key_env": "FATHER_REMOTE_LLM_API_KEY",
      "enabled": false
    }
  ]
}
