  "adversarial_cases": [
    {
      "case_id": "ADV-RT01",
      "attack": "treat an FSTEC SZI certificate as a licence to perform protection work",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT02",
      "attack": "treat a TЗКИ or cryptographic-activity licence as certification of every product used by the licensee",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT03",
      "attack": "apply the current registry status retroactively to an earlier procurement, deployment or incident date",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT04",
      "attack": "treat expiry of a serial-production certificate as automatic invalidity or mandatory removal of every earlier-produced instance",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT05",
      "attack": "treat absence of an expiry date for a unit or batch certificate as certification of all future versions or copies",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT06",
      "attack": "match a certificate by product family or trade name while ignoring version, edition, platform or configuration",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT07",
      "attack": "treat any licence suspension as covering all works and all locations",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT08",
      "attack": "treat existence of a licence record as authorisation for every work, service, branch and contract role",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT09",
      "attack": "use a scanned paper licence or certificate without reconciling it to the authoritative registry record and later decisions",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT10",
      "attack": "apply the PP 313 own-needs maintenance exception to services performed for customers or third parties",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT11",
      "attack": "infer SKZI certification or FSB approval from an FSTEC register entry or from a cryptographic licence",
      "expect": "BLOCKED"
    },
    {
      "case_id": "ADV-RT12",
      "attack": "treat a timeout, missing public field or absent search result as proof that a certificate or licence is absent, active or terminated",
      "expect": "BLOCKED"
    }
  ]
