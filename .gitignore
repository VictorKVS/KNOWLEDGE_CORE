# Local-only source packs. Originals and full standards stay on the workstation.
_LOCAL_SOURCE_PACK/

# Private regulatory corpora and machine-readable extractions.
sources/
security-knowledge/corpus/
security-corpora/
**/00_intake/
**/00_intake_machine_readable/
**/_machine_readable/
**/_audit/

# Private knowledge graphs, weights, evidence and operational databases.
*.sqlite
*.sqlite3
*.db
*.jsonl
**/graphs/private/
**/evidence/private/
**/weights/private/
**/checklists/private/

# Source documents and derived full text must never be published from this repo.
*.pdf
*.odt
*.rtf
*.doc
*.docx
*.epub
*.xml

# Secrets and local execution state.
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.log
*.tmp
__pycache__/
.pytest_cache/
node_modules/

# Explicit public allow-list locations are expected to contain only sanitized data.
!docs/
!docs/public/
!docs/public/**
!schemas/
!schemas/public/
!schemas/public/**
!templates/
!templates/public/
!templates/public/**
!tests/
!tests/**
